{
	"name": "onwrist",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"db:generate": "drizzle-kit generate",
		"seed": "tsx scripts/seed.ts",
		"seed:demo": "NODE_OPTIONS=--import=./scripts/loaders/register.mjs tsx scripts/seed-demo.ts"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"vite": "^8.3.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1140.0",
		"argon2": "^0.45.1",
		"devalue": "^5.8.2",
		"drizzle-orm": "^0.45.3",
		"pg": "^8.23.0",
		"sharp": "^0.35.4",
		"zod": "^4.6.5"
	}
}
